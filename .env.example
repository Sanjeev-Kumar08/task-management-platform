NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/workspace?directConnection=true
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173,http://localhost:5174
APP_URL=http://localhost:4000
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
COOKIE_SECURE=false
LOG_LEVEL=info

# Email: console (dev — logs only, no real inbox; API returns verify/invite links) | resend (prod)
EMAIL_PROVIDER=console
EMAIL_FROM=WorkSpace <noreply@workspace.local>
EMAIL_API_KEY=

# Storage: local (dev) | s3 (prod / R2-compatible)
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=

# Stripe billing (optional in dev — Free plan works without keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Observability
ERROR_TRACKER=console
SENTRY_DSN=